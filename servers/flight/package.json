{
  "name": "@crsiebler/mcp-flight-server",
  "version": "1.0.0",
  "description": "Flight MCP server for flight booking using Duffel API",
  "type": "module",
  "main": "dist/servers/flight/src/index.js",
  "bin": {
    "mcp-flight": "dist/servers/flight/src/index.js"
  },
  "scripts": {
    "build": "node ../../scripts/build.js --server=flight",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "flight",
    "booking",
    "duffel",
    "travel",
    "model-context-protocol"
  ],
  "author": "Cory Siebler <cory.siebler@phitechsolutions.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.6",
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/crsiebler/mcp-suite.git",
    "directory": "servers/flight"
  },
  "bugs": {
    "url": "https://github.com/crsiebler/mcp-suite/issues"
  },
  "homepage": "https://github.com/crsiebler/mcp-suite/tree/main/servers/flight",
  "engines": {
    "node": ">=22.14.0"
  },
  "mcpSuite": {
    "displayName": "Flight (Duffel)",
    "toolInventory": {
      "module": "dist/servers/flight/src/tools/index.js",
      "export": "flightTools"
    },
    "environment": {
      "required": [
        "DUFFEL_API_KEY"
      ],
      "optional": [
        "DUFFEL_ENVIRONMENT",
        "LOG_LEVEL"
      ],
      "notes": "Environment is test by default; this does not verify token environment. Booking/payment/cancellation require scoped host approval. Cancellation uses separate quote and confirm tools."
    }
  }
}
