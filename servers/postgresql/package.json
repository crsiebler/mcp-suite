{
  "name": "@crsiebler/mcp-postgresql-server",
  "version": "1.0.3",
  "description": "PostgreSQL MCP server for database management and query execution",
  "type": "module",
  "main": "dist/servers/postgresql/src/index.js",
  "bin": {
    "mcp-postgresql": "dist/servers/postgresql/src/index.js"
  },
  "scripts": {
    "build": "node ../../scripts/build.js --server=postgresql",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.2",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist"
  ],
  "author": "Cory Siebler <cory.siebler@phitechsolutions.com>",
  "engines": {
    "node": ">=22.14.0"
  },
  "mcpSuite": {
    "displayName": "PostgreSQL",
    "toolInventory": {
      "module": "dist/servers/postgresql/src/tools/index.js",
      "export": "postgresqlTools"
    },
    "environment": {
      "required": [
        "POSTGRESQL_CONNECTION_STRING"
      ],
      "optional": [
        "POSTGRESQL_ALLOW_DANGEROUS_OPERATIONS",
        "POSTGRESQL_SSL_MODE",
        "POSTGRESQL_SSL_CA",
        "POSTGRESQL_QUERY_TIMEOUT_MS",
        "POSTGRESQL_MAX_ROWS",
        "LOG_LEVEL"
      ],
      "notes": "TLS defaults to verify-full; use trusted CA or explicit local disable as documented. Database roles enforce permissions. Dangerous-operation setting is not a security boundary."
    }
  }
}
