{
  "name": "@crsiebler/mcp-canvas-server",
  "version": "2.0.3",
  "description": "Canvas LMS MCP Server - Provides tools for interacting with Canvas API",
  "type": "module",
  "main": "dist/servers/canvas/src/index.js",
  "bin": {
    "mcp-canvas": "dist/servers/canvas/src/index.js"
  },
  "scripts": {
    "build": "node ../../scripts/build.js --server=canvas",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist"
  ],
  "author": "Cory Siebler <cory.siebler@phitechsolutions.com>",
  "engines": {
    "node": ">=22.14.0"
  },
  "mcpSuite": {
    "displayName": "Canvas",
    "toolInventory": {
      "module": "dist/servers/canvas/src/catalog.js",
      "export": "tools"
    },
    "environment": {
      "required": [
        "CANVAS_BASE_URL",
        "CANVAS_API_TOKEN"
      ],
      "optional": [
        "CANVAS_TOOL_CATEGORIES"
      ],
      "notes": "Catalog shows all default tools. CANVAS_TOOL_CATEGORIES can restrict exposure; see docs/canvas-tools.md."
    }
  }
}
