{
  "name": "@crsiebler/mcp-clickup-server",
  "version": "2.0.3",
  "description": "ClickUp MCP server for task management and project organization",
  "type": "module",
  "main": "dist/servers/clickup/src/index.js",
  "bin": {
    "mcp-clickup": "dist/servers/clickup/src/index.js"
  },
  "scripts": {
    "build": "node ../../scripts/build.js --server=clickup",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist"
  ],
  "author": "Cory Siebler <cory.siebler@phitechsolutions.com>",
  "engines": {
    "node": ">=22.14.0"
  },
  "mcpSuite": {
    "displayName": "ClickUp",
    "toolInventory": {
      "module": "dist/servers/clickup/src/tools.js",
      "export": "tools"
    },
    "environment": {
      "required": [
        "CLICKUP_API_TOKEN"
      ],
      "optional": [],
      "notes": "Some tools require a Workspace ID or ClickUp Enterprise. See the documented input migrations."
    }
  }
}
