{
  "name": "mcp-suite",
  "version": "1.0.0",
  "description": "A comprehensive Model Context Protocol (MCP) server suite with modular, extensible server implementations for various integrations.",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/build.js",
    "build:shared": "tsc -p shared/tsconfig.json",
    "clean": "rm -rf dist/",
    "lint": "eslint . --ext .ts,.js,.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit --incremental false",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "test:live": "vitest run --config vitest.live.config.ts",
    "catalog:generate": "node scripts/catalog.cjs --write",
    "catalog:check": "node scripts/catalog.cjs --check",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version && npm install --package-lock-only --ignore-scripts --offline --no-audit --no-fund && npm run catalog:generate",
    "release:version:ci": "npm run release:version && npm run type-check && npm run lint && npm test && npm run catalog:check"
  },
  "keywords": [
    "api",
    "canvas",
    "integration",
    "mcp",
    "model-context-protocol",
    "postgresql",
    "salesforce",
    "server",
    "typescript"
  ],
  "author": "Cory <cory.siebler@phitechsolutions.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/crsiebler/mcp-suite.git"
  },
  "bugs": {
    "url": "https://github.com/crsiebler/mcp-suite/issues"
  },
  "homepage": "https://github.com/crsiebler/mcp-suite#readme",
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@elastic/elasticsearch": "^8.13.4",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.15.4",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "3.9.8",
    "typescript": "^5.9.3",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "axios": "^1.6.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.2"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=10.9.0"
  },
  "private": true,
  "workspaces": [
    "servers/*"
  ]
}
