{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "baseUrl": ".",
    "paths": {
      "shared/*": ["./shared/*"]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "servers/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts",
    "vitest*.config.ts"
  ],
  "exclude": ["node_modules", "**/node_modules/**", "**/dist/**", "**/*.d.ts"]
}
